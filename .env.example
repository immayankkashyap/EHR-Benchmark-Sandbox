# Healthcare EHR Sandbox Environment Variables

# FHIR Server Configuration
FHIR_BASE_URL=http://localhost:8080/fhir
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=hapi

# Auxiliary Tool Ports
DRUG_INTERACTION_PORT=8001
LAB_REFERENCE_PORT=8002
DOSAGE_GUIDELINE_PORT=8003

# Orchestrator Configuration
ORCHESTRATOR_PORT=8000
LOG_LEVEL=INFO

# Egress Proxy Configuration
HTTP_PROXY=http://localhost:3128
HTTPS_PROXY=http://localhost:3128

# Host benchmark API credentials (export only those you use; not loaded automatically)
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=
