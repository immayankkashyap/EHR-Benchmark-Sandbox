{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaseSpecSchema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "salted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot_date": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "salted_fields",
        "snapshot_date"
      ]
    },
    "patient": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string"
            },
            "last_name": {
              "type": "string"
            }
          },
          "required": [
            "first_name",
            "last_name"
          ]
        },
        "gender": {
          "type": "string"
        },
        "birthDate": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "gender",
        "birthDate"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "metadata",
    "patient"
  ]
}
